generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  instance_id                 String?                @db.Uuid
  id                          String                 @id @default(uuid()) @db.Uuid
  aud                         String?                @db.VarChar(255)
  role                        String?                @db.VarChar(255)
  email                       String?                @db.VarChar(255)
  encrypted_password          String?                @db.VarChar(255)
  email_confirmed_at          DateTime?              @db.Timestamptz(6)
  invited_at                  DateTime?              @db.Timestamptz(6)
  confirmation_token          String?                @db.VarChar(255)
  confirmation_sent_at        DateTime?              @db.Timestamptz(6)
  recovery_token              String?                @db.VarChar(255)
  recovery_sent_at            DateTime?              @db.Timestamptz(6)
  email_change_token_new      String?                @db.VarChar(255)
  email_change                String?                @db.VarChar(255)
  email_change_sent_at        DateTime?              @db.Timestamptz(6)
  last_sign_in_at             DateTime?              @db.Timestamptz(6)
  raw_app_meta_data           Json?
  raw_user_meta_data          Json?
  is_super_admin              Boolean?
  createdAt                   DateTime?              @map("created_at") @db.Timestamptz(6)
  updated_at                  DateTime?              @db.Timestamptz(6)
  phone                       String?                @unique
  phone_confirmed_at          DateTime?              @db.Timestamptz(6)
  phone_change                String?                @default("")
  phone_change_token          String?                @default("") @db.VarChar(255)
  phone_change_sent_at        DateTime?              @db.Timestamptz(6)
  confirmed_at                DateTime?              @db.Timestamptz(6)
  email_change_token_current  String?                @default("") @db.VarChar(255)
  email_change_confirm_status Int?                   @default(0) @db.SmallInt
  banned_until                DateTime?              @db.Timestamptz(6)
  reauthentication_token      String?                @default("") @db.VarChar(255)
  reauthentication_sent_at    DateTime?              @db.Timestamptz(6)
  is_sso_user                 Boolean                @default(false)
  deleted_at                  DateTime?              @db.Timestamptz(6)
  is_anonymous                Boolean                @default(false)
  identities                  identities[]
  mfa_factors                 mfa_factors[]
  oauth_authorizations        oauth_authorizations[]
  oauth_consents              oauth_consents[]
  one_time_tokens             one_time_tokens[]
  sessions                    sessions[]
  webauthn_challenges         webauthn_challenges[]
  webauthn_credentials        webauthn_credentials[]
  appointments                Appointment[]
  call_records                call_records[]
  push_subscriptions          PushSubscription[]

  @@index([createdAt(sort: Desc)], map: "idx_users_created_at_desc")
  @@index([email], map: "idx_users_email")
  @@index([last_sign_in_at(sort: Desc)], map: "idx_users_last_sign_in_at_desc")
  @@index([instance_id])
  @@index([is_anonymous])
  @@map("users")
  @@ignore
  @@schema("auth")
}

model StaffAccount {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         String
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  isOnline     Boolean?  @default(false) @map("is_online")
  lastSeen     DateTime? @default(now()) @map("last_seen") @db.Timestamptz(6)

  @@index([isOnline], map: "idx_staff_accounts_is_online")
  @@index([role], map: "idx_staff_accounts_role")
  @@index([username], map: "idx_staff_accounts_username")
  @@map("staff_accounts")
  @@schema("public")
}

model Doctor {
  id              String    @id @default(uuid())
  username        String    @unique
  departmentId    String?   @map("department_id")
  specialty       String
  experience      String?
  experienceYears Int?      @map("experience_years")
  consultationFee Decimal?  @map("consultation_fee") @db.Decimal(10, 2)
  rating          Decimal?  @db.Decimal(3, 2)
  status          String?   @default("active")
  bio             String?
  isAvailable     Boolean   @default(true) @map("is_available")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([username])
  @@map("doctors")
  @@schema("public")
}

model Patient {
  id                      BigInt         @id @default(autoincrement())
  mrn                     String         @unique
  fullName                String         @map("full_name")
  phone                   String
  dateOfBirth             DateTime?      @map("date_of_birth") @db.Date
  gender                  String?
  address                 String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  bloodGroup              String?        @map("blood_group")
  allergies               String?
  chronic_conditions      String?
  notes                   String?
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments            Appointment[]
  consultations           Consultation[]
  labRequests             LabRequest[]
  lab_results             LabResult[]
  prescriptions           Prescription[]

  @@index([mrn], map: "idx_patients_mrn")
  @@index([phone], map: "idx_patients_phone")
  @@map("patients")
  @@schema("public")
}

model Appointment {
  id                    BigInt             @id @default(autoincrement())
  full_name             String?
  phone                 String?
  appointmentDate       DateTime?          @default(dbgenerated("CURRENT_DATE")) @map("appointment_date") @db.Date
  appointment_time      DateTime?          @db.Time(6)
  payment_method        String?            @default("TELEBIRR")
  amount                Decimal            @default(300.00) @db.Decimal(10, 2)
  paymentStatus         String?            @default("pending") @map("payment_status")
  bookingStatus         String             @default("pending") @map("booking_status")
  transaction_reference String?
  chapa_transaction_id  String?
  note                  String?
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patientId             BigInt?            @map("patient_id")
  visitStatus           String             @default("booked") @map("visit_status")
  reminder_sms_sent     Boolean?           @default(false)
  reminder_sms_sent_at  DateTime?          @db.Timestamptz(6)
  reminder_sms_status   String?            @default("pending")
  reminder_sms_error    String?
  user_id               String?            @db.Uuid
  callStatus            String?            @default("idle") @map("call_status")
  consultation_type     String?            @default("ONLINE")
  consultation_fee      Decimal?           @default(100.00) @db.Decimal(10, 2)
  doctorId              String?            @map("doctor_id")
  doctorName            String?            @map("doctor_name")
  patientName           String?            @map("patient_name")
  phoneNumber           String?            @map("phone_number")
  status                String?            @default("PENDING")
  paidAt                DateTime?          @map("paid_at") @db.Timestamptz(6)
  payment_completed_at  DateTime?          @db.Timestamptz(6)
  doctorUsername        String?            @map("doctor_username")
  patient               Patient?           @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  users                 User? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction) @ignore
  call_records          call_records[]
  consultation_notes    ConsultationNote[]
  consultations         Consultation[]
  lab_requests          LabRequest[]
  messages              messages[]
  prescriptions         Prescription[]

  @@index([bookingStatus], map: "appointments_status_idx")
  @@index([appointmentDate], map: "appointments_date_idx")
  @@index([paymentStatus])
  @@index([phone])
  @@index([callStatus], map: "idx_appointments_call_status")
  @@index([appointmentDate], map: "idx_appointments_date")
  @@index([doctorUsername], map: "idx_appointments_doctor_username")
  @@index([patientId], map: "idx_appointments_patient_id")
  @@index([reminder_sms_status], map: "idx_appointments_sms_status")
  @@map("appointments")
  @@schema("public")
}

model Consultation {
  id                         BigInt         @id @default(autoincrement())
  patientId                  BigInt         @map("patient_id")
  appointmentId              BigInt?        @map("appointment_id")
  doctorUsername             String         @default("doctor") @map("doctor_username")
  chiefComplaint             String         @map("chief_complaint")
  history_of_present_illness String?
  blood_pressure             String?
  temperature                String?
  pulse_rate                 String?
  weight                     String?
  height                     String?
  physical_examination       String?
  diagnosis                  String
  treatment_plan             String?
  additional_notes           String?
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointment                Appointment?   @relation(fields: [appointmentId], references: [id], onUpdate: NoAction)
  patient                    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prescriptions              Prescription[]

  @@index([appointmentId], map: "idx_consultations_appointment_id")
  @@index([createdAt], map: "idx_consultations_created_at")
  @@index([patientId], map: "idx_consultations_patient_id")
  @@map("consultations")
  @@schema("public")
}

model ConsultationNote {
  id             BigInt       @id @default(autoincrement())
  appointment_id BigInt?
  doctor_id      String?
  patient_name   String?
  diagnosis      String?
  prescription   String?
  notes          String?
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  appointments   Appointment? @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("consultation_notes")
  @@schema("public")
}

model ConsultationMessage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String    @map("appointment_id")
  roomId        String    @map("room_id")
  senderId      String    @map("sender_id")
  senderName    String    @map("sender_name")
  senderRole    String    @map("sender_role")
  message       String
  message_type  String?   @default("text")
  is_read       Boolean?  @default(false)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([appointmentId], map: "idx_consultation_messages_appointment")
  @@index([createdAt(sort: Desc)], map: "idx_consultation_messages_created")
  @@index([roomId], map: "idx_consultation_messages_room")
  @@map("consultation_messages")
  @@schema("public")
}

model Call {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String    @map("patient_id")
  patientName    String    @map("patient_name")
  doctorUsername String    @map("doctor_username")
  status         String    @default("payment_pending")
  roomId         String    @map("room_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  appointmentId  String?   @map("appointment_id")

  @@map("calls")
  @@schema("public")
}

model LabRequest {
  id              BigInt       @id @default(autoincrement())
  patientId       BigInt       @map("patient_id")
  appointment_id  BigInt?
  doctor_username String       @default("doctor")
  test_name       String
  clinical_notes  String?
  status          String       @default("Requested")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments    Appointment? @relation(fields: [appointment_id], references: [id], onUpdate: NoAction)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  labResults      LabResult[]

  @@index([appointment_id], map: "idx_lab_requests_appointment_id")
  @@index([patientId], map: "idx_lab_requests_patient_id")
  @@index([status], map: "idx_lab_requests_status")
  @@map("lab_requests")
  @@schema("public")
}

model LabResult {
  id             BigInt     @id @default(autoincrement())
  labRequestId   BigInt     @map("lab_request_id")
  patient_id     BigInt
  technician_id  String     @default("laboratory")
  resultValue    String     @map("result_value")
  referenceRange String     @map("reference_range")
  unit           String
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  labRequest     LabRequest @relation(fields: [labRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients       Patient    @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([labRequestId], map: "idx_lab_results_lab_request_id")
  @@index([patient_id], map: "idx_lab_results_patient_id")
  @@map("lab_results")
  @@schema("public")
}

model Medicine {
  id                BigInt             @id @default(autoincrement())
  name              String             @unique
  genericName       String?            @map("generic_name")
  category          String?
  unit              String             @default("tablet")
  is_active         Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  stock_quantity    Int                @default(0)
  dispenseLogs      DispenseLog[]
  prescriptionItems PrescriptionItem[]

  @@index([is_active], map: "idx_medicines_is_active")
  @@map("medicines")
  @@schema("public")
}

model Prescription {
  id                  BigInt             @id @default(autoincrement())
  patientId           BigInt             @map("patient_id")
  appointment_id      BigInt?
  consultationId      BigInt?            @map("consultation_id")
  doctor_username     String
  prescription_status String             @default("Pending")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  dispenseLogs        DispenseLog[]
  items               PrescriptionItem[]
  appointments        Appointment?       @relation(fields: [appointment_id], references: [id], onUpdate: NoAction)
  consultation        Consultation?      @relation(fields: [consultationId], references: [id], onUpdate: NoAction)
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([appointment_id], map: "idx_prescriptions_appointment_id")
  @@index([consultationId], map: "idx_prescriptions_consultation_id")
  @@index([patientId], map: "idx_prescriptions_patient_id")
  @@map("prescriptions")
  @@schema("public")
}

model PrescriptionItem {
  id                     BigInt        @id @default(autoincrement())
  prescriptionId         BigInt        @map("prescription_id")
  medicineId             BigInt?       @map("medicine_id")
  medicine_name_snapshot String
  dosage                 String
  frequency              String
  duration               String
  quantity               Int           @default(1)
  route                  String        @default("Oral")
  instructions           String?
  dispensing_status      String        @default("Pending")
  dispensed_quantity     Int           @default(0)
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @db.Timestamptz(6)
  dispense_log           DispenseLog[]
  medicine               Medicine?     @relation(fields: [medicineId], references: [id], onUpdate: NoAction)
  prescription           Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([prescriptionId], map: "idx_prescription_items_presc_id")
  @@map("prescription_items")
  @@schema("public")
}

model DispenseLog {
  id                   BigInt           @id @default(autoincrement())
  prescriptionId       BigInt           @map("prescription_id")
  prescription_item_id BigInt
  medicineId           BigInt?          @map("medicine_id")
  medicine_name        String
  quantity_dispensed   Int              @default(0)
  pharmacist_username  String
  dispensedAt          DateTime         @default(now()) @map("dispensed_at") @db.Timestamptz(6)
  medicine             Medicine?        @relation(fields: [medicineId], references: [id], onUpdate: NoAction)
  prescription         Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prescription_items   PrescriptionItem @relation(fields: [prescription_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([medicineId], map: "idx_dispense_log_medicine_id")
  @@index([prescriptionId], map: "idx_dispense_log_prescription_id")
  @@map("dispense_log")
  @@schema("public")
}

model PushSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  endpoint   String    @unique
  keys       Json
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  users      User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction) @ignore

  @@map("push_subscriptions")
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log_entries {
  instance_id String?   @db.Uuid
  id          String    @id @db.Uuid
  payload     Json?     @db.Json
  created_at  DateTime? @db.Timestamptz(6)
  ip_address  String    @default("") @db.VarChar(64)

  @@index([instance_id], map: "audit_logs_instance_id_idx")
  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model custom_oauth_providers {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_type           String
  identifier              String    @unique
  name                    String
  client_id               String
  client_secret           String
  acceptable_client_ids   String[]  @default([])
  scopes                  String[]  @default([])
  pkce_enabled            Boolean   @default(true)
  attribute_mapping       Json      @default("{}")
  authorization_params    Json      @default("{}")
  enabled                 Boolean   @default(true)
  email_optional          Boolean   @default(false)
  issuer                  String?
  discovery_url           String?
  skip_nonce_check        Boolean   @default(false)
  cached_discovery        Json?
  discovery_cached_at     DateTime? @db.Timestamptz(6)
  authorization_url       String?
  token_url               String?
  userinfo_url            String?
  jwks_uri                String?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)
  custom_claims_allowlist String[]  @default([])

  @@index([created_at])
  @@index([enabled])
  @@index([identifier])
  @@index([provider_type])
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flow_state {
  id                     String                 @id @db.Uuid
  user_id                String?                @db.Uuid
  auth_code              String?
  code_challenge_method  code_challenge_method?
  code_challenge         String?
  provider_type          String
  provider_access_token  String?
  provider_refresh_token String?
  created_at             DateTime?              @db.Timestamptz(6)
  updated_at             DateTime?              @db.Timestamptz(6)
  authentication_method  String
  auth_code_issued_at    DateTime?              @db.Timestamptz(6)
  invite_token           String?
  referrer               String?
  oauth_client_state_id  String?                @db.Uuid
  linking_target_id      String?                @db.Uuid
  email_optional         Boolean                @default(false)
  saml_relay_states      saml_relay_states[]

  @@index([created_at(sort: Desc)])
  @@index([auth_code], map: "idx_auth_code")
  @@index([user_id, authentication_method], map: "idx_user_id_auth_method")
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model identities {
  provider_id     String
  user_id         String    @db.Uuid
  identity_data   Json
  provider        String
  last_sign_in_at DateTime? @db.Timestamptz(6)
  created_at      DateTime? @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)
  email           String?
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  users           User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction) @ignore

  @@unique([provider_id, provider], map: "identities_provider_id_provider_unique")
  @@index([email])
  @@index([user_id])
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model instances {
  id              String    @id @db.Uuid
  uuid            String?   @db.Uuid
  raw_base_config String?
  created_at      DateTime? @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)

  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mfa_amr_claims {
  session_id            String   @db.Uuid
  created_at            DateTime @db.Timestamptz(6)
  updated_at            DateTime @db.Timestamptz(6)
  authentication_method String
  id                    String   @id(map: "amr_id_pk") @db.Uuid
  sessions              sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, authentication_method], map: "mfa_amr_claims_session_id_authentication_method_pkey")
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mfa_challenges {
  id                     String      @id @db.Uuid
  factor_id              String      @db.Uuid
  created_at             DateTime    @db.Timestamptz(6)
  verified_at            DateTime?   @db.Timestamptz(6)
  ip_address             String      @db.Inet
  otp_code               String?
  web_authn_session_data Json?
  mfa_factors            mfa_factors @relation(fields: [factor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mfa_challenges_auth_factor_id_fkey")

  @@index([created_at(sort: Desc)], map: "mfa_challenge_created_at_idx")
  @@schema("auth")
