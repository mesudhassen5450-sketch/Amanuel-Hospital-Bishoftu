// Invoice Model for Payment System
model Invoice {
  id            String    @id @default(uuid())
  txRef         String    @unique @map("tx_ref")
  appointmentId BigInt?   @map("appointment_id")
  patientId     BigInt?   @map("patient_id")
  doctorId      String?   @map("doctor_id")
  amount        Float
  currency      String    @default("ETB")
  status        String    @default("PENDING") // PENDING, PAID, FAILED, CANCELLED
  paymentMethod String?   @map("payment_method")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("invoices")
  @@schema("public")
}

// Call Status Enum for Video Consultations
enum CallStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  
  @@schema("public")
}

// Call Session Model for Real-Time Doctor-Patient Video Calls
model CallSession {
  id          BigInt      @id @default(autoincrement())
  patientId   BigInt      @map("patient_id")
  doctorId    BigInt      @map("doctor_id")
  channelName String      @unique @map("channel_name")
  status      CallStatus  @default(WAITING)
  startedAt   DateTime?   @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime?   @map("ended_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([doctorId, status])
  @@index([patientId, status])
  @@map("call_sessions")
  @@schema("public")
}
