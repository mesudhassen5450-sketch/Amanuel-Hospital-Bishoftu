# =====================================================
# AMANUEL HOSPITAL - FRONTEND ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to git!

# -----------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Also expose for SSR/Node.js access
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -----------------------------------------------------
# BACKEND API CONFIGURATION
# -----------------------------------------------------
# Express backend URL for REST API calls
# ⚠️ IMPORTANT: Do NOT include /api suffix! The code automatically appends it.
# 
# Development: http://localhost:3001
# Production: https://your-backend.onrender.com
#
# VITE_API_URL: Used for REST API endpoints (/api/staff, /api/payments, etc.)
# VITE_BACKEND_URL: Used for Socket.IO WebSocket connections and real-time features
#
# ✅ CORRECT: VITE_API_URL=https://backend.onrender.com
# ❌ WRONG: VITE_API_URL=https://backend.onrender.com/api (causes 404 errors)
VITE_API_URL=http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# -----------------------------------------------------
# GROQ AI CHATBOT (SITE ASSISTANT)
# -----------------------------------------------------
# Get an API key from: https://console.groq.com/keys
# Set these in Netlify → Site settings → Environment variables
# (server-side only — do NOT use a VITE_ prefix)
GROQ_API_KEY=your_groq_api_key_here
# Optional override. Default replaces retired llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------
# AFROMESSAGE SMS API (OPTIONAL)
# -----------------------------------------------------
# Get API token from: https://afromessage.com
# Only needed if SMS reminder feature is enabled
AFROMESSAGE_API_TOKEN=your_afromessage_api_token_here
AFROMESSAGE_IDENTIFIER_ID=your_sender_id_here

# -----------------------------------------------------
# AGORA VIDEO CALLING (OPTIONAL)
# -----------------------------------------------------
# Get credentials from: https://console.agora.io
# Only needed for telemedicine video consultation feature
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_certificate_here
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
VITE_AGORA_APP_ID=your_agora_app_id_here

# -----------------------------------------------------
# WEB PUSH NOTIFICATIONS (OPTIONAL)
# -----------------------------------------------------
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Only needed for desktop push notification feature
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# -----------------------------------------------------
# PRISMA DATABASE (LOCAL DEVELOPMENT)
# -----------------------------------------------------
# PostgreSQL connection strings
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:6543/dbname?pgbouncer=true&statement_cache_size=0"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# -----------------------------------------------------
# NODE ENVIRONMENT
# -----------------------------------------------------
PORT=3001
NODE_ENV=development

# -----------------------------------------------------
# CHAPA PAYMENT GATEWAY (if using frontend-initiated payments)
# -----------------------------------------------------
# Get your key from: https://dashboard.chapa.co/settings/api-keys
# Only needed if payment initialization is done from frontend
CHAPA_SECRET_KEY=CHASECK_TEST-your_secret_key_here
